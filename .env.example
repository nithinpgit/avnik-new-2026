# Copy to .env for local/prod use: cp .env.example .env
# The root .env file is gitignored — edit your local copy with real secrets.
#
# Public site URLs are intentionally empty: one domain + edge proxy routing.
# Browsers use the current origin / relative paths (/, /api, /admin, /join).

# =============================================================================
# Admin stack (MySQL / Laravel / Node admin / React admin)
# =============================================================================

# MySQL (do not set MYSQL_USER=root)
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=avnikdb
MYSQL_USER=avnik_user
MYSQL_PASSWORD=change_me_db_password
MYSQL_PUBLISHED_PORT=3306

PHPMYADMIN_PORT=8080
PROXY_PORT=7000

ADMIN_BACKEND_PORT=8001
JWT_SECRET=change_me_jwt_secret
SKIP_DB_SYNC=true

LARAVEL_BACKEND_PORT=8000
APP_NAME=Avnik
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:generate_with_php_artisan_key_generate
# Empty = derive from request (proxy Host / X-Forwarded-Proto)
LARAVEL_APP_URL=
FORCE_HTTPS=false
SKIP_MIGRATIONS=true
STRIPE_KEY=
STRIPE_SECRET=

ADMIN_FRONTEND_PORT=8003
ADMIN_FRONTEND_HTTP_PORT=8002
VITE_APP_BASE_PATH=/admin
FRONTEND_VITE_API_BASE_URL=/api
FRONTEND_VITE_IMAGE_BASE_URL=/images
FRONTEND_VITE_MEETING_FRONT_URL=
FRONTEND_VITE_MEETING_API_URL=/api

CHOKIDAR_USEPOLLING=true
NPM_CONFIG_LEGACY_PEER_DEPS=true
VITE_DEV_PROXY_TARGET=http://admin-backend:8001

ADMIN_BACKEND_DOCKERFILE=Dockerfile.local
LARAVEL_DOCKERFILE=Dockerfile.local
ADMIN_FRONTEND_DOCKERFILE=Dockerfile.local

# =============================================================================
# Meeting stack
# =============================================================================

POSTGRES_USER=meet
POSTGRES_PASSWORD=meet
POSTGRES_DB=meet

BACKEND_PORT=3000
BACKEND_DATABASE_URL=postgres://meet:meet@postgres:5432/meet
BACKEND_REDIS_URL=redis://redis:6379
BACKEND_MEDIA_JWT_SECRET=
BACKEND_MEDIA_JWT_TTL_SEC=600
BACKEND_CORS_ORIGIN=*
BACKEND_MEETING_REDIRECT_URL=
BACKEND_DATABASE_SYNC=false
BACKEND_DATABASE_LOGGING=false
BACKEND_RECORDER_SERVICE_URL=http://meet-recorder:4000
BACKEND_API_PREFIX=meet/api

MEDIASERVER_PORT=3001
MEDIASERVER_MEDIA_JWT_SECRET=
MEDIASERVER_LOG_LEVEL=info
MEDIASERVER_ANNOUNCED_IP=127.0.0.1,host.docker.internal
MEDIASERVER_RTC_MIN_PORT=45000
MEDIASERVER_RTC_MAX_PORT=45100
MEDIASERVER_TURN_URLS=
MEDIASERVER_TURN_USERNAME=
MEDIASERVER_TURN_PASSWORD=

FRONTEND_HTTP_PORT=5173
FRONTEND_VITE_MEETING_REDIRECT_URL=
FRONTEND_VITE_EXTERNAL_API_URL=
FRONTEND_VITE_STRIPE_PUBLISHABLE_KEY=
FRONTEND_VITE_EXTERNAL_LOGIN_URL=/login

RECORDER_PORT=4000
RECORDER_FRONTEND_URL=http://proxy:7000/join
RECORDER_MEETING_API_URL=http://meet-backend:3000
RECORDER_PUBLIC_URL=http://127.0.0.1:4000
RECORDER_MEDIA_PUBLIC_WS_URL=
RECORDER_CHUNK_INTERVAL_MS=5000
RECORDER_READY_TIMEOUT_MS=120000
RECORDER_STOP_GRACE_MS=15000
RECORDER_MAX_PARALLEL_RECORDINGS=10
