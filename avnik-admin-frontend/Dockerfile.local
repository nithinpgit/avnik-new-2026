# Development image: nginx on :80 proxies /admin to Vite on :3000.
FROM node:18-alpine
WORKDIR /app
RUN apk add --no-cache libc6-compat nginx
COPY docker-entrypoint.dev.sh /docker-entrypoint.dev.sh
COPY nginx/dev.conf /etc/nginx/http.d/default.conf
RUN chmod +x /docker-entrypoint.dev.sh
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.dev.sh"]
CMD ["nginx", "-g", "daemon off;"]
