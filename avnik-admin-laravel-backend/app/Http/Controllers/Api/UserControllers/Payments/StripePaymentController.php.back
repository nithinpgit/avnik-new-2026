    /**
     * Update the specified resource in storage.
     *
     * @param  \Illuminate\Http\Request  $request
     * @param  int  $id
     * @return \Illuminate\Http\Response
     */
    public function update(Request $request)
    {
        //
        $stripe = new \Stripe\StripeClient(config('services.stripe.secret'));

        $user = auth()->user();
        if ($user) {
            DB::beginTransaction();
            try {
                $slot = EventTimeSlot::where('meeting_room_id', $request->roomId)->first();
                if (!is_null($slot)) {
                    $event = Event::where('id', $slot->event_fk_id)->first();
                    if (!is_null($event)) {
                        if ($event->user_fk_id == auth()->user()->id) {
                            return response()->json(['status' => 'failed', 'success' => false, 'message' => 'sorry You can not book your own event']);
                        }

                        $extend = ExtendDuration::where('room_id', $request->roomId)->orderBy('id', 'desc')->first();

                        if ($extend == null) {
                            if ($event->cost > 0 && $request->cost > 0) {

                                if ($slot && $event) {
                                    $payment = $stripe->paymentIntents->create([
                                        'amount' => 100 * (float)$event->cost,
                                        'currency' => 'usd',
                                        'payment_method' => $request->stripeToken,
                                        'confirm' => true,
                                        'receipt_email' => auth()->user()->email,
                                        'description' => 'Payment for' . $event->title,
                                    ]);
                                    if ($payment->status == "succeeded") {
                                        $eventPayment = new EventPayment();
                                        $eventPayment->user_fk_id = $user->id;
                                        $eventPayment->to_user = $event->user_fk_id;
                                        $eventPayment->event_time_slot_id = $slot->id;
                                        $eventPayment->event_fk_id = $event->id;
                                        $eventPayment->event_date_time = Carbon::now();
                                        $eventPayment->amount = $request->cost;
                                        $eventPayment->stripe_id = $payment->id;
                                        $eventPayment->paid = true;
                                        $eventPayment->accept_by_host = "accepted";
                                        $eventPayment->amount_refunded = $payment->amount_refunded;
                                        $eventPayment->transaction_id = $payment->balance_transaction;
                                        $eventPayment->status = $payment->status;
                                        $eventPayment->save();
                                        DB::commit();
                        
                                        return response()->json(["status" => $this->status_code, "message" => "Payment Done Successfully", "data" => $eventPayment]);
                                    }
                                }
                            }else {
                                $slot = EventTimeSlot::where('meeting_room_id', $request->roomId)->first();
                                $event = Event::where('id', $slot->event_fk_id)->first();
                                if($slot && $event) {
                                    $user = auth()->user();
                                    $eventPayment = new EventPayment();
                                    $eventPayment->user_fk_id = $user->id;
                                    $eventPayment->to_user = $event->user_fk_id;
                                    $eventPayment->event_time_slot_id = $slot->id;
                                    $eventPayment->event_fk_id = $event->id;
                                    $eventPayment->event_date_time = Carbon::now();
                                    $eventPayment->amount = $request->cost;
                                    $eventPayment->paid = false;
                                    $eventPayment->accept_by_host = "accepted";
                                    $eventPayment->amount_refunded = false;
                                    $eventPayment->status = "succeeded";
                                    $eventPayment->save();
                                     DB::commit();
                                    return response()->json(["status" => $this->status_code, "message" => "Payment Done Successfully", "data" => $eventPayment]);
                                }else {
                                    return response()->json(["status" => "failed", "success" => false, "message" => "Event Not Found"]);
                                }
                            }
                        } else {
                            if (!is_null($extend)) {
                                $eventPayment=EventPayment::where('event_fk_id',$event->id)->where('extended',0)->first();
                                $totalCost = $event->cost + $extend->cost;
                                if(!is_null($eventPayment)){
                                    $totalCost=$totalCost-$event->cost;
                                }else{
                                    $totalCost=$totalCost;
                                }

                                if ($totalCost > 0) {
                                    if ($totalCost == $request->cost) {
                                        if ($slot && $event) {
                                            $payment = $stripe->paymentIntents->create([
                                                'amount' => 100 * (float)$request->cost,
                                                'currency' => 'usd',
                                                'payment_method' => $request->stripeToken,
                                                'confirm' => true,
                                                'receipt_email' => auth()->user()->email,
                                                'description' => 'Payment for' . $event->title,
                                            ]);
                                            if ($payment->status == "succeeded") {
                                                $eventPayment = new EventPayment();
                                                $eventPayment->user_fk_id = $user->id;
                                                $eventPayment->to_user = $event->user_fk_id;
                                                $eventPayment->event_time_slot_id = $slot->id;
                                                $eventPayment->event_fk_id = $event->id;
                                                $eventPayment->event_date_time = Carbon::now();
                                                $eventPayment->amount = $request->cost;
                                                $eventPayment->stripe_id = $payment->id;
                                                $eventPayment->paid = true;
                                                $eventPayment->extended = true;
                                                $eventPayment->extended_id = $request->extendedDurationId;
                                                $eventPayment->accept_by_host = "accepted";
                                                $eventPayment->amount_refunded = $payment->amount_refunded;
                                                $eventPayment->transaction_id = $payment->balance_transaction;
                                                $eventPayment->status = $payment->status;
                                                $eventPayment->save();
                                                DB::commit();
                                                return response()->json(["status" => $this->status_code, "message" => "Payment Done Successfully", "data" => $eventPayment]);
                                            }
                                        }
                                    }else if($event->cost == 0 && $request->cost > 0&&$extend->cost==$request->cost){
                                        $slot = EventTimeSlot::where('meeting_room_id', $request->roomId)->first();
                                        $event = Event::where('id', $slot->event_fk_id)->first();
                                        if($slot && $event) {
                                            $user = auth()->user();
                                            $eventPayment = new EventPayment();
                                            $eventPayment->user_fk_id = $user->id;
                                            $eventPayment->to_user = $event->user_fk_id;
                                            $eventPayment->event_time_slot_id = $slot->id;
                                            $eventPayment->event_fk_id = $event->id;
                                            $eventPayment->event_date_time = Carbon::now();
                                            $eventPayment->amount = $request->cost;
                                            $eventPayment->paid = false;
                                            $eventPayment->extended = true;
                                            $eventPayment->extended_id = $request->extendedDurationId;
                                            $eventPayment->accept_by_host = "accepted";
                                            $eventPayment->amount_refunded = false;
                                            $eventPayment->status = "succeeded";
                                            $eventPayment->save();
                                            DB::commit();
                                            return response()->json(["status" => $this->status_code, "message" => "Payment Done Successfully", "data" => $eventPayment]);
                                        }else {
                                            return response()->json(["status" => "failed", "success" => false, "message" => "Event Not Found"]);
                                        } 
                                } else {
                                    return [$event->cost,$request->cost ,$extend->cost,$request->cost];
                                        return response()->json(['status' => 'failed', 'success' => false, 'message' => 'Sorry Wrong Cost']);
                                    }
                                } else {
                                    if ($slot && $event) {
                                        $payment = $stripe->paymentIntents->create([
                                            'amount' => 100 * (float)$request->cost,
                                            'currency' => 'usd',
                                            'payment_method' => $request->stripeToken,
                                            'confirm' => true,
                                            'receipt_email' => auth()->user()->email,
                                            'description' => 'Payment for' . $event->title,
                                        ]);
                                        if ($payment->status == "succeeded") {
                                            $eventPayment = new EventPayment();
                                            $eventPayment->user_fk_id = $user->id;
                                            $eventPayment->to_user = $event->user_fk_id;
                                            $eventPayment->event_time_slot_id = $slot->id;
                                            $eventPayment->event_fk_id = $event->id;
                                            $eventPayment->event_date_time = Carbon::now();
                                            $eventPayment->amount = $request->cost;
                                            $eventPayment->stripe_id = $payment->id;
                                            $eventPayment->paid = true;
                                            $eventPayment->extended = true;
                                            $eventPayment->accept_by_host = "accepted";
                                            $eventPayment->amount_refunded = $payment->amount_refunded;
                                            $eventPayment->transaction_id = $payment->balance_transaction;
                                            $eventPayment->status = $payment->status;
                                            $eventPayment->save();
                                            DB::commit();
                                            return response()->json(["status" => $this->status_code, "message" => "Payment Done Successfully", "data" => $eventPayment]);
                                        }
                                    }
                                }
                            } else {
                                return response()->json(['status' => 'failed', 'success' => false, 'message' => 'sorry something wrong 2']);
                            }
                        }
                    } else {
                        return response()->json(['status' => 'failed', 'success' => false, 'message' => 'sorry something wrong']);
                    }
                } else {
                    return response()->json(['status' => 'failed', 'success' => false, 'message' => 'sorry meeting Not found']);
                }
            } catch (PDOException $e) {

                DB::rollBack();
                return response()->json($e);
            }
        } else {
            return response()->json("login first");
        }
