    /**
     * Remove the specified resource from storage.
     *
     * @param  int  $id
     * @return \Illuminate\Http\Response
     */

    public function freePayment(Request $request, $stripe)
    {
        $slot = EventTimeSlot::where('meeting_room_id', $request->roomId)->first();
        $event = EventTimeSlot::where('id', $slot->event_fk_id)->first();
        if ($slot && $event) {
            $user = auth()->user();
            $eventPayment = new EventPayment();
            $eventPayment->user_fk_id = $user->id;
            $eventPayment->to_user = $event->user_fk_id;
            $eventPayment->event_time_slot_id = $slot->id;
            $eventPayment->event_fk_id = $event->id;
            $eventPayment->event_date_time = Carbon::now();
            $eventPayment->amount = $request->cost;
            $eventPayment->paid = false;
            $eventPayment->accept_by_host = "accepted";
            $eventPayment->amount_refunded = false;
            $eventPayment->status = "succeeded";
            $eventPayment->save();
            DB::commit();
            return response()->json(["status" => $this->status_code, "message" => "Payment Done Successfully", "data" => $eventPayment]);
        } else {
            return response()->json(["status" => "failed", "success" => false, "message" => "Event Not Found"]);
        }
    }
    public function bookSlotExtendedDuration(Request $request, $stripe)
    {
        $user = auth()->user();
        $slot = EventTimeSlot::where('meeting_room_id', $request->roomId)->first();
        $event = EventTimeSlot::where('id', $slot->event_fk_id)->first();
        if ($slot && $event) {
            $payment = $stripe->paymentIntents->create([
                'amount' => 100 * (float)$request->cost,
                'currency' => 'usd',
                'payment_method' => $request->stripeToken,
                'confirm' => true,
                'receipt_email' => auth()->user()->email,
                'description' => 'Payment for' . $event->title,
            ]);
            if ($payment->status == "succeeded") {
                $eventPayment = new EventPayment();
                $eventPayment->user_fk_id = $user->id;
                $eventPayment->to_user = $event->user_fk_id;
                $eventPayment->event_time_slot_id = $slot->id;
                $eventPayment->event_fk_id = $event->id;
                $eventPayment->event_date_time = Carbon::now();
                $eventPayment->amount = $request->cost;
                $eventPayment->stripe_id = $payment->id;
                $eventPayment->paid = true;
                $eventPayment->extended = true;
                $eventPayment->accept_by_host = "accepted";
                $eventPayment->amount_refunded = $payment->amount_refunded;
                $eventPayment->transaction_id = $payment->balance_transaction;
                $eventPayment->status = $payment->status;
                $eventPayment->save();
                DB::commit();
                return response()->json(["status" => $this->status_code, "message" => "Payment Done Successfully", "data" => $eventPayment]);
            }
        }
    }
    public function bookSlot(Request $request, $stripe)
    {
        return [$request, $stripe];
        $user = auth()->user();
        $slot = EventTimeSlot::where('meeting_room_id', $request->roomId)->where('event_fk_id', $request->eventId)->first();
        $event = EventTimeSlot::where('id', $request->eventId)->first();
        if ($slot && $event) {
            $payment = $stripe->paymentIntents->create([
                'amount' => 100 * (float)$event->cost,
                'currency' => 'usd',
                'payment_method' => $request->stripeToken,
                'confirm' => true,
                'receipt_email' => auth()->user()->email,
                'description' => 'Payment for' . $event->title,
            ]);
            if ($payment->status == "succeeded") {
                $eventPayment = new EventPayment();
                $eventPayment->user_fk_id = $user->id;
                $eventPayment->to_user = $event->user_fk_id;
                $eventPayment->event_time_slot_id = $slot->id;
                $eventPayment->event_fk_id = $event->id;
                $eventPayment->event_date_time = Carbon::now();
                $eventPayment->amount = $request->cost;
                $eventPayment->stripe_id = $payment->id;
                $eventPayment->paid = true;
                $eventPayment->extended = true;
                $eventPayment->accept_by_host = "accepted";
                $eventPayment->amount_refunded = $payment->amount_refunded;
                $eventPayment->transaction_id = $payment->balance_transaction;
                $eventPayment->status = $payment->status;
                $eventPayment->save();
                DB::commit();

                return response()->json(["status" => $this->status_code, "message" => "Payment Done Successfully", "data" => $eventPayment]);
            }
        }
    }
    public function destroy($id)
    {
        //
        $Payment = EventPayment::where('id', $id)->delete();
        if ($Payment) {
            return response()->json($Payment);
        } else {
            return response()->json(['delete' => $id]);
        }
    }
